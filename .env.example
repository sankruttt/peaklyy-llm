# Peaklyy Application Configuration (.env.example)

DATABASE_URL=postgresql://postgres@localhost:5432/peaklyy_db
JWT_SECRET=your-secure-jwt-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Configuration (Configured for OpenRouter with Gemma 4 31B Free)
LLM_PROVIDER=openai
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODEL=google/gemma-4-31b-it:free
LLM_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=text-embedding-004

UPLOAD_STORAGE_PATH=./backend/storage/resumes
